{
  "name": "unilink-web-assets",
  "version": "2.0.0",
  "private": true,
  "description": "Offline frontend assets for UNILINK",
  "scripts": {
    "build": "npm run build:css && npm run vendor",
    "build:css": "tailwindcss --config tailwind.config.cjs --input tailwind.input.css --output css/tailwind.css --minify",
    "vendor": "node scripts/vendor-assets.js"
  },
  "devDependencies": {
    "@babel/standalone": "7.25.9",
    "@fontsource-variable/inter": "5.2.6",
    "@fontsource-variable/jetbrains-mono": "5.2.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.17",
    "xlsx": "0.18.5"
  }
}
