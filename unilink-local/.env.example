# Copie para ".env" e preencha. NUNCA commite o .env.
# Gere valores novos para cada instalação; nunca reutilize credenciais do Supabase.

DB_PASSWORD=troque-por-uma-senha-forte
JWT_SECRET=troque-por-64-caracteres-aleatorios-openssl-rand-hex-32

# Tempo de vida do login
TOKEN_TTL=12h

# Opcional: deixe vazio quando frontend e API usam a mesma origem.
CORS_ORIGIN=
